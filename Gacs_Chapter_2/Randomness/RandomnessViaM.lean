import Gacs_Chapter_2.Randomness.LevinSchnorr

/-!
# Randomness via algorithmic probability (Gács §2.3.8, Definition 2.3.38, Theorem 2.3.7)

For a continuous semimeasure `ν` and a computable measure `P`, let

  `δ'(ξ) = sup_n ν(ξ_{1:n}) / P(ξ_{1:n})`   (`ratioTest ν P`, carried on strings as a
  prefix maximum).

* **Theorem 2.3.7** (`ratioTest_isMLSeqTest`): for a lower semicomputable continuous
  semimeasure `ν` — in particular for the universal `M` — `δ'` is a Martin-Löf test.
  Gács' "standard methods" are made explicit: the open set `{δ' > 2^k}` is generated by the
  prefix-minimal strings `y` with `ν(y) > 2^k P(y)`; these form a prefix-free family, so
  `P{δ' > 2^k} = ∑ P(y) ≤ 2^{-k} ∑ ν(y) ≤ 2^{-k}` (`sum_le_one_of_prefixFree`). Neither
  universality nor lower semicomputability is needed for the measure bound.
* `δ' ≥ d̄` (`complexityRatioSup_le_ratioTest`): `2^{-K} ≤ 2^c M` (`KM ≤⁺ K`, Proposition
  2.3.37) gives `R(ξ) ≤ 2^c δ'_M(ξ)`.
* **Same random sequences** (`isRandomSeq_iff_ratioTest`): `ξ` is `P`-random iff
  `δ'_M(ξ) < ∞`. One direction is the comparison above; the other is Theorem 2.3.2 (a)
  applied to the Martin-Löf test `δ'_M` and Theorem 2.3.1.
* `KM(x) ≤⁺ −log P(x)` (`seqMeasure_le_univ`) and, along a random sequence, `KM(ξ_{1:n})`
  stays within a constant of `−log P(ξ_{1:n})` (`univ_comparable_on_random`).

Gács also remarks that `δ'` is in general not expectation-bounded; that negative statement
is not formalized.
-/

namespace Kolmogorov.Randomness

open scoped ENNReal

/-- **Gács' `δ'_P`** (Definition 2.3.38) for a continuous semimeasure `ν`, carried on strings:
`max_{y ⊑ z} ν(y) / P(y)`. -/
noncomputable def ratioTest (ν : BitString → ℝ≥0∞) (P : ComputableSeqMeasure) :
    BitString → ℝ≥0∞ :=
  prefixMax (fun y ↦ ν y / P.mass y)

theorem levelMass_finset_le_sum (μ : BitString → ℝ≥0∞) (hμ : IsSeqMeasure μ)
    (S : Finset BitString) (n : ℕ) : levelMass μ (S : Set BitString) n ≤ ∑ y ∈ S, μ y := by
  refine (levelMass_le_tsum hμ _ n).trans (le_of_eq ?_)
  rw [tsum_eq_sum (s := S) (fun y hy ↦ Set.indicator_of_notMem (by simpa using hy) _)]
  exact Finset.sum_congr rfl fun y hy ↦ Set.indicator_of_mem (Finset.mem_coe.mpr hy) _

/-- `P(y) ≤ 2^{-k} ν(y)` when `2^k < ν(y)/P(y)`. -/
theorem mass_le_of_two_pow_lt_div {p v : ℝ≥0∞} {k : ℕ} (hp : p ≠ ⊤) (h : (2 : ℝ≥0∞) ^ k < v / p) :
    p ≤ 2⁻¹ ^ k * v := by
  rcases eq_or_ne p 0 with hp0 | hp0
  · rw [hp0]; exact zero_le
  · have h' : (2 : ℝ≥0∞) ^ k * p ≤ v :=
      (ENNReal.le_div_iff_mul_le (Or.inl hp0) (Or.inl hp)).mp h.le
    calc p = 2⁻¹ ^ k * (2 ^ k * p) := by
          rw [← mul_assoc, ← ENNReal.inv_pow,
            ENNReal.inv_mul_cancel (two_pow_ne_zero' k) (two_pow_ne_top' k), one_mul]
      _ ≤ 2⁻¹ ^ k * v := mul_le_mul' le_rfl h'

/-- **The measure bound of Theorem 2.3.7**, for any continuous semimeasure `ν`. -/
theorem openMeasure_ratioTest_le {ν : BitString → ℝ≥0∞} (hν : IsContSemimeasure ν)
    (P : ComputableSeqMeasure) (k : ℕ) :
    openMeasure P.mass {z | (2 : ℝ≥0∞) ^ k < ratioTest ν P z} ≤ 2⁻¹ ^ k := by
  classical
  set f : BitString → ℝ≥0∞ := fun y ↦ ν y / P.mass y with hf
  refine iSup_le fun n ↦ ?_
  -- The prefix-minimal strings of length `≤ n` above the threshold.
  set S : Finset BitString := (upTo n).filter
    (fun y ↦ (2 : ℝ≥0∞) ^ k < f y ∧ ∀ j < y.length, ¬ (2 : ℝ≥0∞) ^ k < f (y.take j)) with hS
  have hpf : ∀ x ∈ S, ∀ y ∈ S, x <+: y → x = y := by
    intro x hx y hy hxy
    rw [hS, Finset.mem_filter] at hx hy
    by_contra hne
    have hlt : x.length < y.length := by
      rcases lt_or_eq_of_le hxy.length_le with h | h
      · exact h
      · exact absurd (hxy.eq_of_length h) hne
    have := hy.2.2 x.length hlt
    rw [← List.prefix_iff_eq_take.mp hxy] at this
    exact this hx.2.1
  have hlen : ∀ y ∈ S, y.length ≤ n := fun y hy ↦ by
    rw [hS, Finset.mem_filter] at hy; exact mem_upTo.mp hy.1
  calc levelMass P.mass {z | (2 : ℝ≥0∞) ^ k < ratioTest ν P z} n
      ≤ levelMass P.mass (S : Set BitString) n := by
        unfold levelMass
        refine Finset.sum_le_sum fun w hw ↦ ?_
        split_ifs with h1 h2
        · exact le_rfl
        · exfalso
          obtain ⟨x, hx, hxw⟩ := h1
          -- some prefix of `x` is above the threshold
          have hx' : (2 : ℝ≥0∞) ^ k < prefixMax f x := hx
          unfold prefixMax at hx'
          obtain ⟨i, hi, hfi⟩ := (Finset.lt_sup_iff).mp hx'
          have hiw : w.take i = x.take i := by
            rw [List.prefix_iff_eq_take.mp hxw, List.take_take,
              min_eq_left (Nat.lt_succ_iff.mp (Finset.mem_range.mp hi))]
          have hex : ∃ j, (2 : ℝ≥0∞) ^ k < f (w.take j) := ⟨i, by rw [hiw]; exact hfi⟩
          set j₀ := Nat.find hex
          have hj₀i : j₀ ≤ i := Nat.find_min' hex (by rw [hiw]; exact hfi)
          have hi_len : i ≤ x.length := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          have hwl : w.length = n := ext_zero_length n hw
          have hj₀n : j₀ ≤ n := by have := hxw.length_le; omega
          refine h2 ⟨w.take j₀, ?_, List.take_prefix _ _⟩
          rw [Finset.mem_coe, hS, Finset.mem_filter]
          refine ⟨mem_upTo.mpr ((List.length_take_le _ _).trans (by omega)),
            Nat.find_spec hex, fun j hj ↦ ?_⟩
          rw [List.take_take]
          have hj' : j < j₀ := lt_of_lt_of_le hj (List.length_take_le _ _)
          rw [min_eq_left hj'.le]
          exact Nat.find_min hex hj'
        · exact zero_le
        · exact le_rfl
    _ ≤ ∑ y ∈ S, P.mass y := levelMass_finset_le_sum P.mass P.additive S n
    _ ≤ ∑ y ∈ S, 2⁻¹ ^ k * ν y := by
        refine Finset.sum_le_sum fun y hy ↦ ?_
        rw [hS, Finset.mem_filter] at hy
        exact mass_le_of_two_pow_lt_div (P.mass_ne_top y) hy.2.1
    _ = 2⁻¹ ^ k * ∑ y ∈ S, ν y := (Finset.mul_sum _ _ _).symm
    _ ≤ 2⁻¹ ^ k * 1 := mul_le_mul' le_rfl (sum_le_one_of_prefixFree hν S hpf)
    _ = 2⁻¹ ^ k := mul_one _

/-- **Gács Theorem 2.3.7.** For a lower semicomputable continuous semimeasure `ν` (e.g. the
universal `M`), `δ'(ξ) = sup_n ν(ξ_{1:n}) / P(ξ_{1:n})` is a Martin-Löf test. -/
theorem ratioTest_isMLSeqTest {ν : BitString → ℝ≥0∞} (hν : IsContSemimeasure ν)
    (hνl : IsLSC₁ ν) (P : ComputableSeqMeasure) : IsMLSeqTest P (ratioTest ν P) :=
  ⟨prefixMax_isLSC₁ ((hνl.mul P.computable.inv_isLSC₁).congr
      (fun x ↦ by rw [div_eq_mul_inv])),
    prefixMax_isMonoStr _, openMeasure_ratioTest_le hν P⟩

theorem seqVal_ratioTest (ν : BitString → ℝ≥0∞) (P : ComputableSeqMeasure) (ξ : Seq) :
    seqVal (ratioTest ν P) ξ = ⨆ n, ν (seqTake ξ n) / P.mass (seqTake ξ n) :=
  seqVal_prefixMax _ ξ

/-- `δ'_M ≥ d̄_P` up to a constant, from `KM ≤⁺ K` (Proposition 2.3.37). -/
theorem complexityRatioSup_le_ratioTest {M : BitString → ℝ≥0∞}
    (hM : IsUniversalContSemimeasure M) (U : Map) (hU : IsOptimalPrefixConditional U)
    (P : ComputableSeqMeasure) :
    ∃ c : ℕ, ∀ ξ, complexityRatioSup U P ξ ≤ 2 ^ c * seqVal (ratioTest M P) ξ := by
  obtain ⟨c, hc⟩ := prefixComplexityWeight_le_univ hM U hU
  refine ⟨c, fun ξ ↦ ?_⟩
  rw [seqVal_ratioTest, ENNReal.mul_iSup]
  refine iSup_mono fun n ↦ ?_
  rw [← mul_div_assoc]
  exact ENNReal.div_le_div_right (hc _) _

/-- **Same random sequences.** `ξ` is `P`-random iff `sup_n M(ξ_{1:n}) / P(ξ_{1:n}) < ∞`. -/
theorem isRandomSeq_iff_ratioTest {M : BitString → ℝ≥0∞} (hM : IsUniversalContSemimeasure M)
    (U : Map) (hU : IsOptimalPrefixConditional U) (P : ComputableSeqMeasure) (ξ : Seq) :
    IsRandomSeq P.mass ξ ↔ seqVal (ratioTest M P) ξ ≠ ⊤ := by
  constructor
  · intro h htop
    exact h _ (isConstructiveNull_seqVal_top (ratioTest_isMLSeqTest hM.1 hM.2.1 P)) htop
  · intro h
    rw [isRandomSeq_iff U hU]
    obtain ⟨c, hc⟩ := complexityRatioSup_le_ratioTest hM U hU P
    exact ne_top_of_le_ne_top (ENNReal.mul_ne_top (two_pow_ne_top' c) h) (hc ξ)

/-- `KM(x) ≤⁺ −log P(x)`: a computable measure is dominated by the universal `M`. -/
theorem seqMeasure_le_univ {M : BitString → ℝ≥0∞} (hM : IsUniversalContSemimeasure M)
    (P : ComputableSeqMeasure) : ∃ c : ℕ, ∀ x, P.mass x ≤ 2 ^ c * M x := by
  have hP : IsContSemimeasure P.mass :=
    ⟨P.root.le, fun x ↦ (P.additive x).symm.le⟩
  obtain ⟨c, hc⟩ := hM.2.2 P.mass hP P.computable.isLSC₁
  refine ⟨c, fun x ↦ ?_⟩
  calc P.mass x = 2 ^ c * (2⁻¹ ^ c * P.mass x) := by
        rw [← mul_assoc, ← ENNReal.inv_pow,
          ENNReal.mul_inv_cancel (two_pow_ne_zero' c) (two_pow_ne_top' c), one_mul]
    _ ≤ 2 ^ c * M x := mul_le_mul' le_rfl (hc x)

/-- Along a `P`-random sequence, `M(ξ_{1:n})` and `P(ξ_{1:n})` agree up to a constant factor:
`KM(ξ_{1:n})` does not oscillate around `−log P(ξ_{1:n})`. -/
theorem univ_comparable_on_random {M : BitString → ℝ≥0∞} (hM : IsUniversalContSemimeasure M)
    (U : Map) (hU : IsOptimalPrefixConditional U) (P : ComputableSeqMeasure) {ξ : Seq}
    (hξ : IsRandomSeq P.mass ξ) :
    ∃ c : ℕ, ∀ n, P.mass (seqTake ξ n) ≤ 2 ^ c * M (seqTake ξ n) ∧
      M (seqTake ξ n) ≤ 2 ^ c * P.mass (seqTake ξ n) := by
  obtain ⟨c₁, hc₁⟩ := seqMeasure_le_univ hM P
  have hfin := (isRandomSeq_iff_ratioTest hM U hU P ξ).mp hξ
  obtain ⟨N, hN⟩ := ENNReal.exists_nat_gt hfin
  refine ⟨max c₁ N, fun n ↦ ⟨(hc₁ _).trans ?_, ?_⟩⟩
  · exact mul_le_mul' (pow_le_pow_right₀ one_le_two (le_max_left _ _)) le_rfl
  · have hle : M (seqTake ξ n) / P.mass (seqTake ξ n) ≤ 2 ^ N := by
      calc M (seqTake ξ n) / P.mass (seqTake ξ n) ≤ seqVal (ratioTest M P) ξ := by
            rw [seqVal_ratioTest]
            exact le_iSup (fun n ↦ M (seqTake ξ n) / P.mass (seqTake ξ n)) n
        _ ≤ N := hN.le
        _ ≤ 2 ^ N := by exact_mod_cast (Nat.lt_two_pow_self (n := N)).le
    rw [ENNReal.div_le_iff_le_mul (Or.inr (two_pow_ne_top' N)) (Or.inr (two_pow_ne_zero' N))]
      at hle
    exact hle.trans (mul_le_mul' (pow_le_pow_right₀ one_le_two (le_max_right _ _)) le_rfl)

end Kolmogorov.Randomness
